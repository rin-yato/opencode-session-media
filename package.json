{
  "name": "opencode-session-media",
  "version": "0.2.0",
  "type": "module",
  "description": "An OpenCode Desktop plugin that gathers every image and file a session read, saw, or captured into one browsable panel.",
  "license": "MIT",
  "author": "Yato",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rin-yato/opencode-session-media.git"
  },
  "homepage": "https://github.com/rin-yato/opencode-session-media#readme",
  "bugs": {
    "url": "https://github.com/rin-yato/opencode-session-media/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "media",
    "images",
    "screenshots",
    "gallery",
    "ai"
  ],
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "screenshot.jpg",
    "screenshot-viewer.jpg"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "changeset": "changeset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "vite build",
    "prepublishOnly": "bun run check && bun run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "effect": "4.1.0",
    "electron": "^45.2.3",
    "prettier": "^3.9.10",
    "solid-js": "^1.9.18",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15"
  },
  "publishConfig": {
    "access": "public"
  }
}
